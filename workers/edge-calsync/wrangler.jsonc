{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edge-calsync",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "edge-calsync.neonbutterfly.net/*",
      "zone_name": "neonbutterfly.net"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TOKEN_HASHES",
      "id": "8c555a30d7214ec09d9c2b80eacdb228"
    }
  ],
  "vars": {
    "ORIGIN_BASE_URL": "https://calsync.neonbutterfly.net",
    "ENABLE_CHATGPT": "true",
    "ENABLE_SHORTCUTS": "false",
    "ENABLE_ALEXA": "false",
    "ENABLE_WEBHOOKS": "false",
    "ENABLE_ADMIN_ROUTES": "false",
    "ALEXA_ALLOWED_SKILL_IDS": "",
    "ALEXA_DEFAULT_TIMEZONE": "America/Anchorage"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
